      "text-decoration",
      "text-align",
      "color"
    ],
    "notes": [
      "Use stable unique string IDs for slides and elements.",
      "Use an http or https URL for image src so the imported project can render it.",
      "Slides may include backgroundImage with an http or https image URL.",
      "Use a solid hex color or a CSS linear-gradient string for backgroundColor.",
      "Text content may contain HTML such as <p> and inline styles.",
      "Set text fonts inside content, for example: <p style=\"font-family: 'Montserrat'; font-weight: 700;\">Heading</p>.",
      "Google Fonts are loaded automatically when their family name appears in text HTML.",
      "Coordinates and dimensions are measured in pixels.",
      "Do not embed base64 or data URLs in media src values.",
      "Video and audio elements are not supported by the current editor schema."
    ]
  },
